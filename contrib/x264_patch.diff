From c2d728751687e1c8137d3ad223a498dba81cbfe5 Mon Sep 17 00:00:00 2001
From: Rafael Diniz <rafael@riseup.net>
Date: Mon, 2 Nov 2026 19:18:07 +0000
Subject: [PATCH] TVLTx: export HRD timing/bitrate header in raw output

Prepend a per-frame header (dts, pts, real_bitrate, payload_size,
is_keyframe) to each NAL write in the raw output module, consumed by
the TVLTx encoder. real_bitrate is declared extern in base.h and
defined once in base.c so it links under -fno-common (GCC >= 10).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 common/base.c     |  3 +++
 common/base.h     |  3 +++
 encoder/encoder.c |  1 +
 output/raw.c      | 20 ++++++++++++++++++++
 4 files changed, 27 insertions(+)

diff --git a/common/base.c b/common/base.c
index 34277277..2c87e496 100644
--- a/common/base.c
+++ b/common/base.c
@@ -26,6 +26,9 @@
 
 #include "base.h"
 
+/* TVLTx */
+int real_bitrate;
+
 #include <ctype.h>
 
 #if HAVE_MALLOC_H
diff --git a/common/base.h b/common/base.h
index 3e4d23d3..ee5cf1c8 100644
--- a/common/base.h
+++ b/common/base.h
@@ -48,6 +48,9 @@
 #include <assert.h>
 #include <limits.h>
 
+/* TVLTx: real HRD bitrate chosen by x264, exported in the raw output frame header */
+extern int real_bitrate;
+
 /****************************************************************************
  * Macros
  ****************************************************************************/
diff --git a/encoder/encoder.c b/encoder/encoder.c
index 20e620aa..61a71716 100644
--- a/encoder/encoder.c
+++ b/encoder/encoder.c
@@ -1811,6 +1811,7 @@ x264_t *x264_encoder_open( x264_param_t *param, void *api )
 
     if( h->param.i_nal_hrd )
     {
+    real_bitrate = h->sps->vui.hrd.i_bit_rate_unscaled;
         x264_log( h, X264_LOG_DEBUG, "HRD bitrate: %i bits/sec\n", h->sps->vui.hrd.i_bit_rate_unscaled );
         x264_log( h, X264_LOG_DEBUG, "CPB size: %i bits\n", h->sps->vui.hrd.i_cpb_size_unscaled );
     }
diff --git a/output/raw.c b/output/raw.c
index 10b4bcfb..fe730d0b 100644
--- a/output/raw.c
+++ b/output/raw.c
@@ -52,6 +52,26 @@ static int write_headers( hnd_t handle, x264_nal_t *p_nal )
 
 static int write_frame( hnd_t handle, uint8_t *p_nalu, int i_size, x264_picture_t *p_picture )
 {
+    // Encoder Header
+    struct 
+    {
+	double dts;
+	double pts;
+	int real_bitrate;
+	int payload_size;
+	int is_keyframe;
+    } x264_header;
+
+    x264_header.dts = p_picture->hrd_timing.cpb_removal_time;
+    x264_header.pts = p_picture->hrd_timing.dpb_output_time;
+    x264_header.real_bitrate = real_bitrate;
+    x264_header.payload_size = i_size;
+    x264_header.is_keyframe = p_picture->b_keyframe;
+
+    fwrite(&x264_header, sizeof(x264_header), 1, (FILE*)handle);
+
+//    printf("x264 payload size = %d\n", i_size);
+
     if( fwrite( p_nalu, i_size, 1, (FILE*)handle ) )
         return i_size;
     return -1;
-- 
